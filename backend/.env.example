# Copy this file to .env and fill in real values. Nothing in the code needs to change —
# every value below is already wired up to be read from here.

# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/tea_shop"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Razorpay (Phase 2) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (Phase 4) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HerbAmrit <orders@yourdomain.com>"

# --- WhatsApp order notifications --- swap provider in src/services/whatsapp.service.js if not using Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""   # Twilio WhatsApp sender, e.g. their sandbox number "+14155238886"
DEFAULT_COUNTRY_CODE="+91"  # prepended to any customer phone number not already in +XX... format

# --- GST / Business details (Phase 2, printed on invoices) ---
GST_BUSINESS_NAME="Your Business Legal Name"
GST_NUMBER=""
GST_BUSINESS_ADDRESS="Your registered business address"

# Note: Amazon store URL, WhatsApp number, social links, and loyalty rates are no
# longer set here — they're editable at /admin/settings once the app is running.
